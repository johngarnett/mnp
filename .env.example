# Data and credentials (CREDENTIALS_FOLDER holds privkey.pem, cert.pem and chain.pem for TLS=internal)
CREDENTIALS_FOLDER=../dev.credentials
DATA_FOLDER=../data
#UPLOADS_FOLDER must be a fully qualified path
UPLOADS_FOLDER=/full/path/to/data/uploads
CURRENT_SEASON=season-0
NUM_WEEKS=10
LEAGUE_ADMINS=admin

# The league: match rules, branding, deployment (docs/formats.md, docs/branding.md)
MATCH_FORMAT=ten-player
BRANDING_FOLDER=./branding/example
#BRANDING_URL=https://raw.githubusercontent.com/<org>/<branding-repo>/main
#PUBLIC_URL=https://league.example.com
TLS=internal
#PORT=443
#TRUST_PROXY=loopback

# Email (the sender account)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_ADDRESS=noreply@example.com
EMAIL_NAME=Example League
EMAIL_PASSWORD=

# Optional services
IFPA_API_KEY=
#Score detection service (keep the key secret; never commit it)
SCORE_SERVICE_URL=https://api.scores.pinball.group
SCORE_SERVICE_API_KEY=
TEST_EMAIL_ADDRESS=
